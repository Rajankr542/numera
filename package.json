{
  "name": "nativpy",
  "private": true,
  "version": "0.0.0",
  "description": "NumPy semantics. Native performance. JavaScript/TypeScript API.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@8.7.6",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm build:native && pnpm build:ts",
    "build:native": "cmake-js compile --CDNATIVPY_BUILD_TESTS=OFF",
    "build:native:debug": "cmake-js compile --debug --CDNATIVPY_BUILD_TESTS=OFF",
    "build:ts": "tsc -p packages/nativpy/tsconfig.json",
    "test": "vitest run",
    "test:native": "cmake -S . -B build-tests -G Ninja -DNATIVPY_BUILD_ADDON=OFF -DNATIVPY_BUILD_TESTS=ON -DCMAKE_BUILD_TYPE=Debug && cmake --build build-tests && ctest --test-dir build-tests --output-on-failure",
    "test:asan": "cmake -S . -B build-asan -G Ninja -DNATIVPY_BUILD_ADDON=OFF -DNATIVPY_BUILD_TESTS=ON -DNATIVPY_SANITIZE=ON -DCMAKE_BUILD_TYPE=Debug && cmake --build build-asan && ctest --test-dir build-asan --output-on-failure",
    "test:diff": "python3 python/generators/generate_cases.py && vitest run --config vitest.diff.config.ts",
    "bench": "node --expose-gc benchmarks/nativpy/creation.bench.mjs",
    "bench:numpy": "python3 benchmarks/numpy/creation_bench.py",
    "bench:suite": "node --expose-gc benchmarks/nativpy/suite.bench.mjs",
    "bench:suite:numpy": "python3 benchmarks/numpy/suite_bench.py",
    "bench:compare": "node benchmarks/compare.mjs",
    "typecheck": "tsc -p packages/nativpy/tsconfig.json --noEmit",
    "prebuilds": "node scripts/build-prebuilds.mjs",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "cmake-js": "^8.0.0",
    "node-addon-api": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}

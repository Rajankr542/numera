{
  "name": "nativpy",
  "version": "1.0.0",
  "description": "NumPy for JavaScript/TypeScript: n-dimensional arrays, broadcasting, linear algebra, random and FFT backed by a native C++ core.",
  "license": "MIT",
  "author": "Rajan Kumar",
  "homepage": "https://github.com/Rajankr542/nativpy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rajankr542/nativpy.git",
    "directory": "packages/nativpy"
  },
  "bugs": {
    "url": "https://github.com/Rajankr542/nativpy/issues"
  },
  "keywords": [
    "numpy",
    "numpy-js",
    "ndarray",
    "n-dimensional",
    "array",
    "tensor",
    "matrix",
    "vector",
    "math",
    "mathematics",
    "numerical",
    "numeric",
    "scientific-computing",
    "linear-algebra",
    "linalg",
    "matmul",
    "svd",
    "eigenvalues",
    "statistics",
    "random",
    "fft",
    "broadcasting",
    "data-science",
    "machine-learning",
    "native",
    "napi",
    "node-addon",
    "cpp",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
